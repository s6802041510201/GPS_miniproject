# Google Maps Platform keys for native development and production builds.
# Keep the real .env file local. Never commit real API keys.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_GPS_ACCURACY_LIMIT_METERS=150
GOOGLE_MAPS_ANDROID_API_KEY=replace_with_android_key
GOOGLE_MAPS_IOS_API_KEY=replace_with_ios_key

# These identifiers must match the restrictions configured for each API key.
EXPO_ANDROID_PACKAGE=com.kmutnb.geoattendance
EXPO_IOS_BUNDLE_IDENTIFIER=com.kmutnb.geoattendance
